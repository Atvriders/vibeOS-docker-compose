# syntax=docker/dockerfile:1
#
# Development Dockerfile for vibeOS (Next.js 15.5 + Claude Code).
#
# Runs `next dev` with hot reload. docker-compose.dev.yml bind-mounts the repo
# over /app (and keeps the image's /app/node_modules via an anonymous volume),
# so the dependencies and runtime binaries baked here are what the live-reloaded
# code uses.
#
# Build:  docker build -f Dockerfile.dev -t ghcr.io/atvriders/vibeos-docker-compose:dev .
# No secrets are required at build time.
FROM oven/bun:1

# ---------------------------------------------------------------------------
# Base layout
# ---------------------------------------------------------------------------
WORKDIR /app

# Put bun's global install dir at a shared, on-PATH location so binaries
# installed globally as root (e.g. the `claude` CLI the SDK spawns) are
# resolvable by the non-root `nextjs` runtime user too. Also keep python tools
# (uv/uvx) on PATH.
ENV BUN_INSTALL=/usr/local/bun
ENV PATH=/usr/local/bun/bin:/usr/local/bin:$PATH

# ---------------------------------------------------------------------------
# System dependencies (installed FIRST — they also provide `adduser`, which the
# current oven/bun:1 base image no longer ships by default).
# ---------------------------------------------------------------------------
# - adduser: needed to create the non-root user below (absent from the base)
# - python3-pip + uv: power the `uvx` python runners (browser-use, dedalus)
# - nodejs + npm: needed by `npx puppeteer ...` and assorted tooling
# - libc6:amd64 / libstdc++6:amd64: multi-arch libs the prebuilt binaries need
# Clean the apt lists afterwards to keep the image slim.
RUN dpkg --add-architecture amd64 \
    && apt-get update \
    && apt-get install -y \
        adduser \
        python3-pip \
        nodejs \
        npm \
        libc6:amd64 \
        libstdc++6:amd64 \
        ca-certificates \
    && pip3 install --break-system-packages uv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user (uid 502, primary group gid 20).
# NOTE: gid 20 on this Debian-based oven/bun image is the `dialout` group, NOT
# `staff` (staff is gid 50). We keep the historical `nextjs:staff` ownership
# convention below; the user owns every file by uid, so reads/writes work
# regardless of group.
RUN adduser --system --uid 502 --gid 20 nextjs

# Install the Claude Code CLI globally (the SDK spawns the `claude` binary).
# Lands in $BUN_INSTALL/bin -> on PATH for every user including `nextjs`.
RUN bun add -g @anthropic-ai/claude-code

# ---------------------------------------------------------------------------
# Application dependencies
# ---------------------------------------------------------------------------
# In dev we keep the FULL dependency tree (devDeps included) so `next dev`,
# tailwind, typescript, etc. all work. Plain `bun install` so a slightly
# out-of-sync committed lockfile cannot fail the build.
COPY package.json bun.lock ./
RUN bun install

# ---------------------------------------------------------------------------
# Non-root home + Chrome for puppeteer/browser-use
# ---------------------------------------------------------------------------
# Create the runtime user's home up front so the Chrome download cache lands
# under /home/nextjs/.cache/puppeteer (owned by nextjs), where browser-use can
# find it when it spawns Chrome at runtime as the non-root user.
RUN mkdir -p /home/nextjs && chown -R nextjs:staff /home/nextjs

ENV HOME=/home/nextjs
ENV PUPPETEER_CACHE_DIR=/home/nextjs/.cache/puppeteer

# Install Chrome as the nextjs user so the binary + cache are owned by and
# reachable for the runtime user. Pin puppeteer 24.x: >=25 needs Node >=22.12
# but this base ships Node 20 (24.x supports Node >=18).
RUN chown -R nextjs:staff /app
USER nextjs
RUN npx --yes puppeteer@24 browsers install chrome
USER root

# ---------------------------------------------------------------------------
# Application source
# ---------------------------------------------------------------------------
# Copied so the image is runnable standalone; docker-compose.dev.yml bind-mounts
# the live repo over this for hot reload.
COPY --chown=nextjs:staff . .

# Ensure the whole tree (including freshly copied source) is owned by nextjs.
RUN chown -R nextjs:staff /app

# Switch to the non-root runtime user for the dev server.
USER nextjs

# ---------------------------------------------------------------------------
# Runtime configuration (development)
# ---------------------------------------------------------------------------
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

EXPOSE 3000

# Start the Next.js dev server with hot reload (`bun run dev` == `next dev`,
# binds to HOSTNAME:PORT == 0.0.0.0:3000).
CMD ["bun", "run", "dev"]
